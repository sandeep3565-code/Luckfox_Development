# Crosstool-NG Configuration for ARM Rockchip830 (RV1106)
# Exact replication from the existing toolchain

CT_CONFIG_VERSION="3"
CT_EXPERIMENTAL=y

# Local Tarballs (for offline builds)
CT_LOCAL_TARBALLS_DIR="${TARBALLS_DIR}"

# Installation Prefix
CT_PREFIX_DIR="${INSTALL_PATH}/x-tool/${CT_TARGET}"

# Target Architecture
CT_ARCH_ARM=y
CT_ARCH_ARM_INTERWORKING=y
CT_ARCH_ARCH="armv7-a"
CT_ARCH_TUNE="cortex-a7"
CT_ARCH_FPU="neon-vfpv4"
CT_ARCH_FLOAT_HW=y
CT_ARCH_FLOAT="hard"

# Target OS & Vendor
CT_TARGET_VENDOR="rockchip830"
CT_KERNEL_LINUX=y

# Linux Kernel Configuration
CT_LINUX_SRC_CUSTOM=y
CT_LINUX_CUSTOM_VERSION=y
CT_LINUX_VERSION="5.10.66"

# Binutils Configuration
CT_BINUTILS_VERSION="2.32"
CT_BINUTILS_LINKER_LD_GOLD=y
CT_BINUTILS_GOLD_THREADS=y
CT_BINUTILS_LD_WRAPPER=y
CT_BINUTILS_PLUGINS=y

# GCC Configuration
CT_CC_LANG_CXX=y
CT_GCC_VERSION="8.3.0"
CT_GCC_ENABLE_CXX_FLAGS="-O2"

# C Library - uClibc
CT_LIBC_UCLIBC=y
CT_LIBC_UCLIBC_IPV6=y
CT_LIBC_UCLIBC_WCHAR=y
CT_LIBC_UCLIBC_VERSION="1.0.31"

# Debug Tools
CT_DEBUG_GDB=y
CT_DEBUG_GDB_VERSION="8.2.1"
CT_DEBUG_DUMA=y
CT_DEBUG_STRACE=y
CT_DEBUG_LTRACE=y

# ISL Support
CT_ISL_SRC_CUSTOM=y
CT_ISL_CUSTOM_VERSION=y
CT_ISL_VERSION="0.24"

# Build Options
CT_SAVE_TARBALLS=y
CT_FORCE_DOWNLOAD=y
CT_BUILD_MANUALS=n
